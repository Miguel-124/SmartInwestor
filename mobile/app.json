{
  "expo": {
    "name": "SmartInwestor",
    "slug": "smartinwestor",
    "owner": "mikemiguel12",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo_SmartInwestor.jpeg",
    "scheme": "smartinwestor",
    "userInterfaceStyle": "dark",
